# ==============================================================
# NovaUnzip Configuration Environment
# ==============================================================

# Required: Telegram API credentials from https://my.telegram.org
API_ID=12345678
API_HASH=0123456789abcdef0123456789abcdef

# Required: Bot token from @BotFather
BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Required: Telegram User ID of the owner
OWNER_ID=987654321

# Optional: Comma-separated list of authorized user IDs (leave empty for public bot)
AUTH_USERS=987654321,11223344

# Quotas and safety
MAX_EXTRACT_SIZE_GB=10
SPLIT_CHUNK_SIZE_MB=1950
PROGRESS_UPDATE_INTERVAL=3.5
WORKDIR=./downloads

# Optional: Telegram Premium session string (enables 4GB uploads instead of 2GB)
# USERBOT_SESSION=
